generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// TENANTS
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  // Set once at onboarding. CONSTRUCTION tenants keep the original
  // project-ledger UI; REAL_ESTATE tenants get the property lifecycle UI.
  vertical     Vertical      @default(CONSTRUCTION)
  // Only meaningful for REAL_ESTATE: SOLO = one owner, SYNDICATION = several
  // investors holding stakes in properties.
  investorMode InvestorMode?
  // Currency all portfolio totals are reported in.
  baseCurrency String        @default("PHP")

  branding       TenantBranding?
  features       TenantFeature[]
  users          User[]
  projects       Project[]
  accounts       Account[]
  listItems      ListItem[]
  expenses       Expense[]
  payrolls       Payroll[]
  collections    Collection[]
  transfers      Transfer[]
  auditLogs      AuditLog[]
  entrySequences EntrySequence[]

  properties     RealProperty[]
  ledgerAccounts LedgerAccount[]
  journalEntries JournalEntry[]
  fxRates        FxRate[]
  investors      Investor[]
  documents      Document[]
}

enum Vertical {
  CONSTRUCTION
  REAL_ESTATE
}

enum InvestorMode {
  SOLO
  SYNDICATION
}

model TenantBranding {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  company  String  @default("")
  ink      String  @default("#101634")
  accent   String  @default("#2E4ABE")
  accent2  String  @default("#32A9DC")
  positive String  @default("#0C6B59")
  negative String  @default("#C0242E")
  paper    String  @default("#EEF1F7")
  logoUrl  String?
}

// Module on/off switches. Absence of a row means "enabled" (see FEATURE_KEYS
// default-on behaviour in src/lib/tenant.ts), so a tenant only needs rows for
// the modules it turns OFF.
model TenantFeature {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key      String
  enabled  Boolean @default(true)

  @@unique([tenantId, key])
}

// ---------------------------------------------------------------------------
// USERS & ROLES
// ---------------------------------------------------------------------------

enum Role {
  Encoder
  Foreman
  Bookkeeper
  Owner
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  pinHash   String
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  projects UserProject[]

  @@unique([tenantId, name])
}

model UserProject {
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

// ---------------------------------------------------------------------------
// PROJECTS, ACCOUNTS, LISTS
// ---------------------------------------------------------------------------

model Project {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  no        String?
  name      String
  client    String?
  contract  Decimal   @default(0) @db.Decimal(14, 2)
  status    String    @default("Ongoing")
  startDate DateTime?
  endDate   DateTime?
  notes     String?

  users       UserProject[]
  expenses    Expense[]
  payrolls    Payroll[]
  collections Collection[]

  @@unique([tenantId, name])
}

enum AccountKind {
  Bank
  Cash
}

model Account {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  kind           AccountKind
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)

  @@unique([tenantId, name])
}

enum ListType {
  category
  paymentMethod
  supplier
}

model ListItem {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type     ListType
  value    String

  @@unique([tenantId, type, value])
}

// Row-locked counter behind nextEntryId() in src/lib/registers.ts. Replaces
// the old "scan the sheet for the first empty row" numbering scheme.
model EntrySequence {
  tenantId   String
  register   String
  year       Int
  lastNumber Int    @default(0)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, register, year])
}

// ---------------------------------------------------------------------------
// REGISTERS — append-only, void instead of delete
// ---------------------------------------------------------------------------

model Expense {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryId     String
  date        DateTime
  particulars String
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  category    String
  supplier    String?
  invoice     String?
  amount      Decimal   @db.Decimal(14, 2)
  paidFrom    String
  notes       String?
  voidedAt    DateTime?
  voidReason  String?
  byUserId    String
  byName      String
  at          DateTime  @default(now())

  @@unique([tenantId, entryId])
  @@index([tenantId, date])
}

model Payroll {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryId     String
  payPeriod   String
  payDate     DateTime
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  workers     String?
  regularPay  Decimal   @db.Decimal(14, 2)
  otPay       Decimal   @default(0) @db.Decimal(14, 2)
  deductions  Decimal   @default(0) @db.Decimal(14, 2)
  caGiven     Decimal   @default(0) @db.Decimal(14, 2)
  caDeduction Decimal   @default(0) @db.Decimal(14, 2)
  paidBy      String
  reference   String?
  remarks     String?
  voidedAt    DateTime?
  voidReason  String?
  byUserId    String
  byName      String
  at          DateTime  @default(now())

  @@unique([tenantId, entryId])
  @@index([tenantId, payDate])
}

model Collection {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryId       String
  date          DateTime
  particulars   String
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  billAmount    Decimal   @db.Decimal(14, 2)
  paymentMethod String
  chequeRef     String?
  ewt           Decimal   @default(0) @db.Decimal(14, 2)
  depositedTo   String
  remarks       String?
  voidedAt      DateTime?
  voidReason    String?
  byUserId      String
  byName        String
  at            DateTime  @default(now())

  @@unique([tenantId, entryId])
  @@index([tenantId, date])
}

model Transfer {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryId     String
  date        DateTime
  particulars String
  fromAccount String
  toAccount   String
  amount      Decimal   @db.Decimal(14, 2)
  reference   String?
  notes       String?
  voidedAt    DateTime?
  voidReason  String?
  byUserId    String
  byName      String
  at          DateTime  @default(now())

  @@unique([tenantId, entryId])
  @@index([tenantId, date])
}

// ---------------------------------------------------------------------------
// AUDIT LOG — every write, never deleted
// ---------------------------------------------------------------------------

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String?
  userName String
  role     String
  action   String
  register String?
  entryId  String?
  details  String?
  at       DateTime @default(now())

  @@index([tenantId, at])
}

// ---------------------------------------------------------------------------
// REAL ESTATE — property lifecycle (BUY → RENT → HOLD → SELL)
// ---------------------------------------------------------------------------

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  LAND
  MIXED_USE
}

// Mirrors STAGES in src/lib/finance/lifecycle.ts.
enum PropertyStage {
  PROSPECT
  UNDER_CONTRACT
  OWNED
  LEASED
  HELD
  LISTED
  SOLD
}

model RealProperty {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  type          PropertyType
  stage         PropertyStage @default(PROSPECT)
  // Each property is booked in its own currency; reports convert to the
  // tenant's baseCurrency using FxRate.
  currency      String
  address       String?
  city          String?
  country       String?
  purchasePrice Decimal?      @db.Decimal(18, 2)
  purchaseDate  DateTime?
  closingCosts  Decimal       @default(0) @db.Decimal(18, 2)
  currentValue  Decimal?      @db.Decimal(18, 2)
  salePrice     Decimal?      @db.Decimal(18, 2)
  soldDate      DateTime?
  notes         String?
  createdAt     DateTime      @default(now())

  units          Unit[]
  stageEvents    PropertyStageEvent[]
  journalEntries JournalEntry[]
  stakes         PropertyStake[]
  loans          Loan[]
  documents      Document[]

  @@unique([tenantId, name])
  @@index([tenantId, stage])
}

model PropertyStageEvent {
  id         String         @id @default(cuid())
  propertyId String
  property   RealProperty   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromStage  PropertyStage?
  toStage    PropertyStage
  byName     String
  note       String?
  at         DateTime       @default(now())

  @@index([propertyId, at])
}

model Unit {
  id         String       @id @default(cuid())
  propertyId String
  property   RealProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label      String
  marketRent Decimal      @default(0) @db.Decimal(18, 2)

  leases Lease[]

  @@unique([propertyId, label])
}

model Lease {
  id          String    @id @default(cuid())
  unitId      String
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantName  String
  monthlyRent Decimal   @db.Decimal(18, 2)
  deposit     Decimal   @default(0) @db.Decimal(18, 2)
  startDate   DateTime
  endDate     DateTime?
  endedAt     DateTime?

  @@index([unitId])
}

// Syndication mode: who holds how much of a property. Percentages for one
// property must total 100 (enforced in the action, not the DB).
model Investor {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  email    String?

  stakes PropertyStake[]

  @@unique([tenantId, name])
}

model PropertyStake {
  investorId String
  propertyId String
  investor   Investor     @relation(fields: [investorId], references: [id], onDelete: Cascade)
  property   RealProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  percent    Decimal      @db.Decimal(7, 4)

  @@id([investorId, propertyId])
}

// ---------------------------------------------------------------------------
// FX
// ---------------------------------------------------------------------------

// "1 `fromCcy` = `rate` `toCcy`" as of a date. Rows are never edited; a new
// rate is a new row, so historical reports stay reproducible.
model FxRate {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromCcy  String
  toCcy    String
  rate     Decimal  @db.Decimal(20, 8)
  asOf     DateTime
  source   String   @default("manual")

  @@index([tenantId, fromCcy, toCcy, asOf])
}

// ---------------------------------------------------------------------------
// DOUBLE-ENTRY LEDGER — append-only, void by reversal flag like the registers
// ---------------------------------------------------------------------------

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model LedgerAccount {
  id       String            @id @default(cuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code     String
  name     String
  type     LedgerAccountType
  // Cash & bank accounts feed the cash-flow statement.
  isCash   Boolean           @default(false)

  lines JournalLine[]

  @@unique([tenantId, code])
}

model JournalEntry {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryNo    String
  date       DateTime
  memo       String
  propertyId String?
  property   RealProperty? @relation(fields: [propertyId], references: [id])
  // Currency the lines are written in, and its rate into the tenant's base
  // currency on the entry date (frozen at posting time).
  currency   String
  fxToBase   Decimal       @default(1) @db.Decimal(20, 8)
  voidedAt   DateTime?
  voidReason String?
  byUserId   String
  byName     String
  at         DateTime      @default(now())

  lines JournalLine[]

  @@unique([tenantId, entryNo])
  @@index([tenantId, date])
  @@index([propertyId, date])
}

model JournalLine {
  id        String        @id @default(cuid())
  entryId   String
  entry     JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id])
  debit     Decimal       @default(0) @db.Decimal(18, 2)
  credit    Decimal       @default(0) @db.Decimal(18, 2)

  @@index([entryId])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// FINANCING (HOLD phase)
// ---------------------------------------------------------------------------

// Fully-amortising loan. Balance and payment are derived from the terms
// (src/lib/finance/amortization.ts) instead of stored, so they can't drift.
model Loan {
  id              String       @id @default(cuid())
  propertyId      String
  property        RealProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lender          String
  principal       Decimal      @db.Decimal(18, 2)
  annualRate      Decimal      @db.Decimal(8, 6)
  termYears       Int
  paymentsPerYear Int          @default(12)
  startDate       DateTime
  createdAt       DateTime     @default(now())

  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// DOCUMENTS VAULT
// ---------------------------------------------------------------------------

enum DocCategory {
  DEED
  TITLE
  CLOSING
  LEASE
  INSURANCE
  TAX
  INSPECTION
  RECEIPT
  LOAN
  OTHER
}

// File bytes live in object storage (src/lib/storage); this row is the index.
// Like every other record here it is append-only: "deleting" voids the row and
// keeps the file, because these are legal/financial records.
model Document {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId     String?
  property       RealProperty? @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  category       DocCategory
  name           String
  originalName   String
  storageKey     String        @unique
  mimeType       String
  sizeBytes      Int
  sha256         String
  // Drives expiry alerts (insurance renewal, lease end, permit, ...).
  expiresOn      DateTime?
  uploadedById   String
  uploadedByName String
  createdAt      DateTime      @default(now())
  voidedAt       DateTime?
  voidReason     String?

  @@index([tenantId, propertyId])
  @@index([tenantId, expiresOn])
}
