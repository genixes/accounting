generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// TENANTS
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  branding TenantBranding?
  features TenantFeature[]
  users    User[]
  projects Project[]
  accounts Account[]
  listItems ListItem[]
  expenses    Expense[]
  payrolls    Payroll[]
  collections Collection[]
  transfers   Transfer[]
  auditLogs   AuditLog[]
  entrySequences EntrySequence[]
}

model TenantBranding {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  company  String @default("")
  ink      String @default("#101634")
  accent   String @default("#2E4ABE")
  accent2  String @default("#32A9DC")
  positive String @default("#0C6B59")
  negative String @default("#C0242E")
  paper    String @default("#EEF1F7")
  logoUrl  String?
}

// Module on/off switches. Absence of a row means "enabled" (see FEATURE_KEYS
// default-on behaviour in src/lib/tenant.ts), so a tenant only needs rows for
// the modules it turns OFF.
model TenantFeature {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key      String
  enabled  Boolean @default(true)

  @@unique([tenantId, key])
}

// ---------------------------------------------------------------------------
// USERS & ROLES
// ---------------------------------------------------------------------------

enum Role {
  Encoder
  Foreman
  Bookkeeper
  Owner
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  pinHash   String
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  projects UserProject[]

  @@unique([tenantId, name])
}

model UserProject {
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

// ---------------------------------------------------------------------------
// PROJECTS, ACCOUNTS, LISTS
// ---------------------------------------------------------------------------

model Project {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  no       String?
  name     String
  client   String?
  contract Decimal  @default(0) @db.Decimal(14, 2)
  status   String   @default("Ongoing")
  startDate DateTime?
  endDate   DateTime?
  notes     String?

  users       UserProject[]
  expenses    Expense[]
  payrolls    Payroll[]
  collections Collection[]

  @@unique([tenantId, name])
}

enum AccountKind {
  Bank
  Cash
}

model Account {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  kind           AccountKind
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)

  @@unique([tenantId, name])
}

enum ListType {
  category
  paymentMethod
  supplier
}

model ListItem {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type     ListType
  value    String

  @@unique([tenantId, type, value])
}

// Row-locked counter behind nextEntryId() in src/lib/registers.ts. Replaces
// the old "scan the sheet for the first empty row" numbering scheme.
model EntrySequence {
  tenantId   String
  register   String
  year       Int
  lastNumber Int    @default(0)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, register, year])
}

// ---------------------------------------------------------------------------
// REGISTERS — append-only, void instead of delete
// ---------------------------------------------------------------------------

model Expense {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryId     String
  date        DateTime
  particulars String
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  category    String
  supplier    String?
  invoice     String?
  amount      Decimal   @db.Decimal(14, 2)
  paidFrom    String
  notes       String?
  voidedAt    DateTime?
  voidReason  String?
  byUserId    String
  byName      String
  at          DateTime  @default(now())

  @@unique([tenantId, entryId])
  @@index([tenantId, date])
}

model Payroll {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryId     String
  payPeriod   String
  payDate     DateTime
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  workers     String?
  regularPay  Decimal   @db.Decimal(14, 2)
  otPay       Decimal   @default(0) @db.Decimal(14, 2)
  deductions  Decimal   @default(0) @db.Decimal(14, 2)
  caGiven     Decimal   @default(0) @db.Decimal(14, 2)
  caDeduction Decimal   @default(0) @db.Decimal(14, 2)
  paidBy      String
  reference   String?
  remarks     String?
  voidedAt    DateTime?
  voidReason  String?
  byUserId    String
  byName      String
  at          DateTime  @default(now())

  @@unique([tenantId, entryId])
  @@index([tenantId, payDate])
}

model Collection {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryId       String
  date          DateTime
  particulars   String
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  billAmount    Decimal   @db.Decimal(14, 2)
  paymentMethod String
  chequeRef     String?
  ewt           Decimal   @default(0) @db.Decimal(14, 2)
  depositedTo   String
  remarks       String?
  voidedAt      DateTime?
  voidReason    String?
  byUserId      String
  byName        String
  at            DateTime  @default(now())

  @@unique([tenantId, entryId])
  @@index([tenantId, date])
}

model Transfer {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryId     String
  date        DateTime
  particulars String
  fromAccount String
  toAccount   String
  amount      Decimal   @db.Decimal(14, 2)
  reference   String?
  notes       String?
  voidedAt    DateTime?
  voidReason  String?
  byUserId    String
  byName      String
  at          DateTime  @default(now())

  @@unique([tenantId, entryId])
  @@index([tenantId, date])
}

// ---------------------------------------------------------------------------
// AUDIT LOG — every write, never deleted
// ---------------------------------------------------------------------------

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String?
  userName String
  role     String
  action   String
  register String?
  entryId  String?
  details  String?
  at       DateTime @default(now())

  @@index([tenantId, at])
}
