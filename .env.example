# --- Required everywhere ---------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/accounting"
# Signs sessions and keys OTP hashes. Generate: openssl rand -base64 48
JWT_SECRET=""

# --- Firm / bookkeeping funnel ---------------------------------------------
# Public base URL, used in emails and payment redirects.
APP_URL="http://localhost:3000"
# "mock" = local payment simulator (REFUSED in production). "paymongo" = real.
BILLING_PROVIDER="mock"
# Required when BILLING_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
# Which signature in the Paymongo-Signature header to trust: "test" or "live"
PAYMONGO_MODE="test"

# "console" prints mail to the server log in development only. "resend" sends for real.
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="Tala Books <no-reply@your-domain.example>"
SUPPORT_EMAIL="hello@your-domain.example"

# Bearer token for POST /api/cron/email (required in production)
CRON_SECRET=""

# Integration tests only: a DISPOSABLE database. Tests TRUNCATE tables.
# DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/accounting_test"
