DATABASE_URL=postgresql://user:pass@localhost:5432/accounting
JWT_SECRET=change-me

# Document storage (real-estate vault). Set STORAGE_BUCKET to use any
# S3-compatible service; REQUIRED in production. Without it, non-production
# runs fall back to local disk under .data/uploads.
# STORAGE_BUCKET=my-bucket
# STORAGE_REGION=auto                       # e.g. us-east-1 for AWS; "auto" for Cloudflare R2
# STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS S3
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
